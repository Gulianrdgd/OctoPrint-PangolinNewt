<form class="form-horizontal">

  <div class="control-group">
    <label class="control-label">Pangolin Endpoint</label>
    <div class="controls">
      <input type="text" class="input-block-level"
             data-bind="value: settings.plugins.pangolin.pangolin_endpoint"
             placeholder="https://app.pangolin.net">
      <span class="help-block">
        Leave as default for Pangolin Cloud. Change only if you self-host Pangolin.
      </span>
    </div>
  </div>

  <div class="control-group">
    <label class="control-label">Newt ID</label>
    <div class="controls">
      <input type="text" class="input-block-level"
             data-bind="value: settings.plugins.pangolin.newt_id"
             placeholder="e.g. 31frd0uzbjvp721"
             autocomplete="off">
      <span class="help-block">
        Found in your Pangolin dashboard under Sites → your site → Newt config.
      </span>
    </div>
  </div>

  <div class="control-group">
    <label class="control-label">Newt Secret</label>
    <div class="controls">
      <input type="password" class="input-block-level"
             data-bind="value: settings.plugins.pangolin.newt_secret"
             placeholder="your newt secret"
             autocomplete="new-password">
      <span class="help-block">
        Treat this like a password. It is stored in OctoPrint's config.yaml.
      </span>
    </div>
  </div>

  <div class="control-group">
    <label class="control-label">Auto-start</label>
    <div class="controls">
      <label class="checkbox">
        <input type="checkbox"
               data-bind="checked: settings.plugins.pangolin.autostart">
        Start Newt automatically when OctoPrint starts
      </label>
    </div>
  </div>

  <div class="control-group">
    <label class="control-label">Newt binary</label>
    <div class="controls">
      <span class="help-block" style="margin-top:0">
        The plugin automatically downloads and installs Newt to
        <code>/usr/local/bin/newt</code> the first time it runs (or when you click
        "Install now" in the sidebar). No manual steps needed.
      </span>
    </div>
  </div>

</form>
